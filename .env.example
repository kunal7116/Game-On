# =============================================================
# .env.example — Environment variable template
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:
#        Windows CMD:   copy .env.example .env
#        Git Bash/Mac:  cp .env.example .env
#   2. Replace every "changeme" value with a real value.
#   3. NEVER commit .env to Git — it is already in .gitignore.
#
# WHY ENVIRONMENT VARIABLES?
#   Hard-coded passwords in source code become public the moment
#   you push to GitHub — even in a "private" repo.  Environment
#   variables keep secrets out of version control entirely.
# =============================================================

# ---------------------------------------------------------------
# MySQL Database Settings
# These are used by both the db container (to initialise MySQL)
# and the backend container (to connect to MySQL).
# ---------------------------------------------------------------

# Root password for MySQL — needed by the official MySQL Docker image.
MYSQL_ROOT_PASSWORD=changeme_root_password

# The database name that will be created automatically.
MYSQL_DATABASE=sportsLeague_db

# App-level MySQL user (less privileged than root).
# The backend connects as this user.
MYSQL_USER=gameuser

# Password for the app-level MySQL user.
MYSQL_PASSWORD=changeme_db_password

# ---------------------------------------------------------------
# JWT (JSON Web Token) Signing Secret
# ---------------------------------------------------------------
# Used by the Spring Boot backend to sign and verify JWT tokens.
# Must be at least 64 characters long for HS512 security.
# Generate a strong value with:
#   openssl rand -base64 64
JWT_SECRET=changeme_use_openssl_rand_base64_64_to_generate_this_value

# ---------------------------------------------------------------
# Frontend Origin (used for CORS)
# ---------------------------------------------------------------
# The URL the React frontend is served from.
# In Docker Compose with the default port mapping this is:
FRONTEND_ORIGIN=http://localhost:3000
